<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- uCrop activity on Android 15+: opt out of edge-to-edge enforcement
         so the apply button is not covered by the system bar. -->
    <style name="Theme.AppCompat.Light.NoActionBar.Override" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
